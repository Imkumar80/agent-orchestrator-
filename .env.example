# Bind to loopback for local-only access.
ORCHESTRATOR_HTTP_ADDR=127.0.0.1:8080

# SQLite database path. Parent directories are created when needed.
ORCHESTRATOR_SQLITE_PATH=./data/orchestrator.db

# Only providers with registered adapters can be enabled. Codex is currently
# the only implemented adapter.
ORCHESTRATOR_ENABLED_PROVIDERS=codex

# Optional executable path; when empty, the server resolves "codex" on PATH.
CODEX_EXECUTABLE=

# Grace period used for HTTP shutdown and session cleanup.
ORCHESTRATOR_SHUTDOWN_TIMEOUT=15s
